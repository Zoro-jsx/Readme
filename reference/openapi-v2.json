{
  "openapi": "3.1.0",
  "info": {
    "title": "Court Record API",
    "description": "REST API for the Court Record backend",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/api/v2",
      "description": "Version 2"
    }
  ],
  "tags": [
    {
      "name": "v2",
      "description": "Version 2 endpoints"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Always false for error responses",
            "default": false,
            "example": false
          },
          "message": {
            "type": "string",
            "description": "Error message indicating what went wrong",
            "example": "Error message"
          },
          "moreInfo": {
            "type": "string",
            "description": "Additional debug info or error details",
            "example": "No additional info found."
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Always false for error responses",
            "default": false,
            "example": false
          },
          "message": {
            "type": "string",
            "description": "General failure message",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "description": "Detailed list of field validation errors",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "The field that failed validation",
                  "example": "email"
                },
                "message": {
                  "type": "string",
                  "description": "Validation failure details",
                  "example": "Invalid email address"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          },
          "moreInfo": {
            "type": "string",
            "description": "Additional debug info",
            "example": "No additional info found."
          }
        },
        "required": [
          "success",
          "message",
          "errors"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the currently authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user data — name restructured from v1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "_id": {
                          "type": "string",
                          "example": "64b8f1a2c3d4e5f6a7b8c9d0"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "example": "user@example.com"
                        },
                        "name": {
                          "type": "object",
                          "properties": {
                            "first": {
                              "type": "string",
                              "example": "John"
                            },
                            "last": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "example": "Doe"
                            }
                          },
                          "required": [
                            "first",
                            "last"
                          ]
                        },
                        "phone": {
                          "type": "string",
                          "example": "+91 98765 43210"
                        },
                        "roleId": {
                          "type": "object",
                          "properties": {
                            "_id": {
                              "type": "string",
                              "example": "64b8f1a2c3d4e5f6a7b8c9d1"
                            },
                            "name": {
                              "type": "string",
                              "enum": [
                                "client",
                                "lawyer",
                                "admin"
                              ],
                              "example": "client"
                            },
                            "displayName": {
                              "type": "string",
                              "example": "Client"
                            },
                            "permissions": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "example": [
                                "cases:read",
                                "documents:read"
                              ]
                            }
                          },
                          "required": [
                            "_id",
                            "name",
                            "displayName",
                            "permissions"
                          ]
                        },
                        "isVerified": {
                          "type": "boolean",
                          "example": true
                        },
                        "isActive": {
                          "type": "boolean",
                          "example": true
                        },
                        "createdAt": {
                          "type": "string",
                          "example": "2024-01-01T00:00:00.000Z"
                        },
                        "updatedAt": {
                          "type": "string",
                          "example": "2024-01-01T00:00:00.000Z"
                        }
                      },
                      "required": [
                        "_id",
                        "email",
                        "name",
                        "roleId",
                        "isVerified",
                        "isActive",
                        "createdAt",
                        "updatedAt"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "response"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "An unhandled internal server error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}